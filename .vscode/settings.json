{
	"search.exclude": {
		"**/__pycache__": true,
		"**/.venv": true,
		"**/.pytest_cache": true,
		"**/.ruff_cache": true,
		"**/.mypy_cache": true,
		"**/*.egg-info": true
	},
	"codeLens.enableCodeLens": true,
	"codeLens.filterImports": false,
	"codeLens.filterDefinitions": true,
	"python.useEnvironmentsExtension": true,
	"workspace.searchEnabled": true,
	"editor.inlayHints.enabled": "on",
	"editor.inlayHints.fontFamily": "Consolas",
	"editor.inlayHints.fontSize": 9,
	"editor.inlayHints.padding": true,
	"markdownlint.config": {
		"ol": false,
		"single-h1": false
	},
	"evenBetterToml.formatter.allowedBlankLines": 2,
	"evenBetterToml.formatter.columnWidth": 180,
	"evenBetterToml.schema.enabled": false,
	"python.testing.cwd": "${workspaceFolder}/heyclaw",
	"python.testing.pytestArgs": [
		"tests"
	],
	"python.testing.unittestEnabled": false,
	"python.testing.pytestEnabled": true,
	"python.terminal.activateEnvironment": false,
	"python.envFile": "${workspaceFolder}/heyclaw/.env",
	"mypy-type-checker.args": [
		"--config-file=pyproject.toml"
	],
	"mypy-type-checker.importStrategy": "fromEnvironment",
	"mypy-type-checker.reportingScope": "workspace",
	"mypy-type-checker.cwd": "${workspaceFolder}/heyclaw",
	"ruff.configurationPreference": "filesystemFirst",
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": false,
		"editor.codeActionsOnSave": {
			"source.fixAll.ruff": "explicit",
			"source.organizeImports.ruff": "explicit"
		},
		"editor.rulers": [
			100
		]
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	}
}
